{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.turbo/**"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "build:desktop-agent": {
      "dependsOn": [
        "@mesacode/shared-types#build",
        "@mesacode/contracts#build",
        "@mesacode/dynamic-workflow#build",
        "@mesacode/core#build",
        "@mesacode/adapters#build",
        "@mesacode/bootstrap#build",
        "@mesacode/i18n#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/../../packages/shared/package.json",
        "$TURBO_ROOT$/../../packages/shared/src/**",
        "!dist/**",
        "!.turbo/**",
        "$TURBO_ROOT$/../../config/provider/mesacode-builtin.json",
        "$TURBO_ROOT$/../../scripts/builtin-provider-config.mjs",
        "$TURBO_ROOT$/../../scripts/load-endpoint-env.mjs",
        "$TURBO_ROOT$/../../packages/provider/src/**",
        "$TURBO_ROOT$/../../packages/provider-node/src/mesacode-builtin-release.ts",
        "$TURBO_ROOT$/../../packages/model-option-map/src/**",
        "$TURBO_ROOT$/../../.env",
        "$TURBO_ROOT$/../../.env.production",
        "$TURBO_ROOT$/../../.env.development",
        "$TURBO_ROOT$/../../.env.development.local",
        "$TURBO_ROOT$/../../package.json",
        "$TURBO_ROOT$/../../pnpm-lock.yaml"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": ["MESACODE_ENV", "MESACODE_BUILTIN_PROVIDER_CONFIG_FILE", "NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "lint:fix": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "@mesacode/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!.turbo/**",
        "$TURBO_ROOT$/../../config/provider/mesacode-builtin.json",
        "$TURBO_ROOT$/../../scripts/builtin-provider-config.mjs",
        "$TURBO_ROOT$/../../scripts/load-endpoint-env.mjs",
        "$TURBO_ROOT$/../../packages/provider/src/**",
        "$TURBO_ROOT$/../../packages/provider-node/src/mesacode-builtin-release.ts",
        "$TURBO_ROOT$/../../packages/model-option-map/src/**",
        "$TURBO_ROOT$/../../packages/shared/src/**",
        "$TURBO_ROOT$/../../.env",
        "$TURBO_ROOT$/../../.env.production",
        "$TURBO_ROOT$/../../.env.development",
        "$TURBO_ROOT$/../../.env.development.local",
        "$TURBO_ROOT$/../../package.json",
        "$TURBO_ROOT$/../../pnpm-lock.yaml"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": ["MESACODE_ENV", "MESACODE_BUILTIN_PROVIDER_CONFIG_FILE", "NODE_ENV"]
    }
  }
}
